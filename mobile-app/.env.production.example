# Loaded automatically by Expo CLI for release/production builds
# (NODE_ENV=production — e.g. `expo run:android --variant release`,
# and EAS "production" profile builds via eas.json's own env override).
#
# Copy this to .env.production (gitignored, like .env) before a production
# build. 104.248.149.103 is the production droplet; this goes through
# nginx on port 80 rather than straight at the API's port 3002, matching
# scripts/nginx-cloudways.conf's reverse proxy.
#
# NOTE: this is plain HTTP — there is no domain/TLS certificate set up for
# this server yet, so PIN sign-in traffic is not encrypted in transit.
# Worth fixing with a real domain + free TLS (e.g. Let's Encrypt) before
# wide release.
EXPO_PUBLIC_API_URL=http://104.248.149.103/api/v1
