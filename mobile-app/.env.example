# Your computer's LAN IP + the backend port (3002 in dev per .env there).
# "localhost" will NOT work here — a phone running Expo Go is a separate
# device on your network and can't resolve "localhost" as your computer.
#
# Find your IP:
#   macOS:   ipconfig getifaddr en0   (or check Wi-Fi settings)
#   Windows: ipconfig                 (look for IPv4 Address)
#
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.42:3002/api/v1
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_LAN_IP:3002/api/v1
